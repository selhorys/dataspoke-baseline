# ==============================================================================
# DataSpoke prod operator inputs
# ==============================================================================
# Copy to helm-charts/.env.prod (gitignored) and fill in. This file is the ONE
# place a prod install takes operator input from; the values overlay carries the
# rest of the deployment's shape. This copy is a template — it is never passed
# as --env-file.
#
# Naming — the prefix is the profile a variable belongs to:
#   DATASPOKE_KUBE_*  — Kubernetes deployment shape (read by helm-charts/bin/*.sh; both profiles)
#   DATASPOKE_PROD_*  — prod-profile operator inputs (this file only)
#   DATASPOKE_DEV_*   — dev-profile inputs; a line here makes this file ambiguous
#                       to the post-install seeds, which refuse to guess a profile
#   DATASPOKE_*       — application runtime, read by app pods from the ConfigMap
#                       and the credentials Secret. NEVER put one in this file:
#                       scripts `source` it, so a stale copy shadows the Secret.
#                       The pre-flight rejects a bare application-runtime name,
#                       exempting only DATASPOKE_AWS_PROFILE and
#                       DATASPOKE_DOCKER_SUDO below — build-host tooling that no
#                       pod reads.
#
# Sections:
#   1. Kubernetes deployment shape          (DATASPOKE_KUBE_*)
#   2. The eleven credentials Secret inputs (DATASPOKE_PROD_*, blank by default)
#   3. Identity and the seeded admin        (DATASPOKE_PROD_*)
#   4. LLM inference                        (DATASPOKE_PROD_LLM_*)
#   5. Peripheral connections               (DATASPOKE_PROD_PERIPHERAL_*)
#
# Sections 1-3 are needed before the install; sections 4-5 are applied after it
# by the two post-install seed scripts and can be filled in later — at the cost
# each block's own header states.
#
# The two-command sequence:
#   ./helm-charts/bin/install-prod-preflight.sh --values <your-overlay.yaml>
#   ./helm-charts/bin/install.sh --profile prod --image-tag <tag> --values <your-overlay.yaml>
# The pre-flight validates this file, the overlay and the cluster, resolves
# section 2, creates the credentials Secret, and prints the second command with
# the tag it derived. `--verify-only` runs every check and mutates nothing.
# See helm-charts/README.md §Prod profile and spec/feature/HELM_CHART.md.
# ==============================================================================


# ==============================================================================
# 1. Kubernetes Deployment Shape  (DATASPOKE_KUBE_*)
# ==============================================================================
# Read by helm-charts/bin/*.sh. Same convention in both profiles; values differ.

# --- Cluster context ----------------------------------------------------------
# Run `kubectl config get-contexts` to list available contexts. The pre-flight
# refuses to run unless this is the CURRENT context: it adopts credentials from
# this cluster's Secret, and resolving under another context would copy a
# different deployment's credentials into this file.
DATASPOKE_KUBE_CLUSTER="<prod-cluster-context>"

# --- Namespace ----------------------------------------------------------------
# Everything the release owns lands here, the credentials Secret included. The
# pre-flight creates it only under --create-namespace.
DATASPOKE_KUBE_DATASPOKE_NAMESPACE=dataspoke

# --- Ingress ------------------------------------------------------------------
# Prod always uses the operator's existing ingress controller.
DATASPOKE_KUBE_INGRESS_MODE=shared
# The IngressClass every DataSpoke Ingress (API, frontend, Airflow) binds to.
# REQUIRED in prod — there is no default, because install.sh passes this by
# `--set`, which outranks the `className` written in your --values overlay. A
# default would silently republish the API, frontend, and Airflow UI on any
# class that happens to be named `nginx`, possibly another team's
# internet-facing controller. Both the pre-flight and install.sh verify it
# exists in the cluster.
DATASPOKE_KUBE_INGRESS_CLASS=nginx
# The domain the release's hosts sit under. The release itself takes its hosts
# from the overlay's ingress sections, so the install does not read this — but
# bin/health-check.sh --profile prod builds every probe URL from it.
DATASPOKE_KUBE_INGRESS_DOMAIN="<your-domain>"
# Scheme for ingress-domain-based URLs served by the umbrella chart's own
# Ingresses (frontend, Airflow). Prod is typically TLS-offloaded at the
# shared controller/load balancer, hence `https` here.
DATASPOKE_KUBE_INGRESS_SCHEME=https
# Optional: name of a pre-created TLS Secret for the shared controller to
# terminate TLS with, if your overlay's Ingress resources reference one.
# DATASPOKE_KUBE_INGRESS_TLS_SECRET="<your-tls-secret>"

# --- Image builds -------------------------------------------------------------
# Image-build dispatch: GCP (Cloud Build), AWS (ECR + local Docker), or empty
# (local Docker). Shared/EKS prod typically uses AWS.
DATASPOKE_KUBE_CLOUD_VENDOR=GCP
DATASPOKE_KUBE_IMAGE_REGISTRY="<your-registry>"
# AWS only (required when CLOUD_VENDOR=AWS): CLI profile for ECR auth/repo
# creation, and whether docker needs sudo.
# DATASPOKE_AWS_PROFILE="<your-profile>"
# DATASPOKE_DOCKER_SUDO=false


# ==============================================================================
# 2. The Eleven Credentials Secret Inputs  (DATASPOKE_PROD_*)
# ==============================================================================
# Each DATASPOKE_PROD_<X> below supplies key DATASPOKE_<X> of the credentials
# Secret your overlay names in `secrets.existingSecret` (default:
# dataspoke-secrets). App pods read that Secret; nothing reads this file.
#
# LEAVE THEM BLANK. A blank line is a REQUEST, not an omission — the pre-flight
# resolves each key in this order and writes the result back here:
#
#   1. your own value, when the line is non-empty;
#   2. otherwise the value THIS CLUSTER'S SECRET IS ALREADY USING (adopt);
#   3. otherwise a freshly generated value.
#
# Adoption precedes generation for a reason worth understanding before you type
# a value into any of these lines. DATASPOKE_PROD_AIRFLOW_FERNET_KEY encrypts
# Airflow's stored connections and Variables inside the Postgres PVC, and that
# PVC survives `helm uninstall`. A key that changes while the PVC survives
# leaves everything it encrypted permanently undecryptable, and Airflow reports
# it at decrypt time rather than at install time. The same argument applies more
# weakly to the rest: a re-install with freshly typed values contradicts what a
# running deployment is using.
#
# After the first pre-flight run this file holds all eleven, which is what makes
# a deleted credentials Secret recoverable — the pre-flight rebuilds it
# byte-identically. That relocates the risk rather than removing it: THIS FILE
# becomes the thing to protect.
#
# One of the eleven cannot be generated: DATASPOKE_PROD_GOOGLE_OAUTH_CLIENT_SECRET
# is issued by the Google Cloud Console alongside the client id. A blank there
# stops the pre-flight.

DATASPOKE_PROD_POSTGRES_PASSWORD=
DATASPOKE_PROD_REDIS_PASSWORD=
# Airflow's own login pair, checked by SimpleAuthManager at every Airflow login
# under this chart's default. The username is not a secret but is rejected if it
# equals `admin`, or if it carries anything outside [A-Za-z0-9._-] — it is
# composed into airflow.extraEnv, which the vendored Airflow chart renders
# through Go `tpl`. Generated as dataspoke-admin-<8 hex chars> when blank.
DATASPOKE_PROD_AIRFLOW_USER=
DATASPOKE_PROD_AIRFLOW_PASSWORD=
DATASPOKE_PROD_AIRFLOW_WEBSERVER_SECRET_KEY=
DATASPOKE_PROD_AIRFLOW_JWT_SECRET=
# URL-safe base64 of exactly 32 raw bytes — 43 characters then `=`. A hex string
# of the right length passes pod startup and fails Airflow's own decrypt at
# first use, so the shape is checked rather than the presence. Read the
# adoption paragraph above before setting this by hand.
DATASPOKE_PROD_AIRFLOW_FERNET_KEY=
DATASPOKE_PROD_INTERNAL_TOKEN=
DATASPOKE_PROD_JWT_SECRET_KEY=
DATASPOKE_PROD_OAUTH_STATE_SECRET=
# Issued by the Google Cloud Console with the client id below. Nothing can
# generate it, so a blank line here is the one credential that stops the
# pre-flight rather than being resolved.
DATASPOKE_PROD_GOOGLE_OAUTH_CLIENT_SECRET=


# ==============================================================================
# 3. Identity and the Seeded Admin  (DATASPOKE_PROD_*)
# ==============================================================================

# --- Google OAuth client id ---------------------------------------------------
# Your record of the public half of the OAuth pair. The deployment itself reads
# `auth.googleClientId` from the values overlay, so set it in BOTH places; the
# pre-flight warns when the two disagree, because a mismatched pair installs
# cleanly and fails at the OAuth callback with invalid_client.
DATASPOKE_PROD_GOOGLE_OAUTH_CLIENT_ID=

# --- Built-in admin password --------------------------------------------------
# The install seeds the built-in admin `dataspoke@dataspoke.local` with the
# password published in this repository. When this is set, the same seed step
# rotates that account to it and verifies the result, closing the window in the
# same command. When it is blank, the published credential stays LIVE and the
# deployment is not production-ready until you rotate it by hand
# (PATCH /api/v1/auth/me).
#
# 10-128 characters — the bound PATCH /api/v1/auth/me enforces — and not the
# literal `dataspoke`. Aim well above that floor: 16+ characters, mixed case, at
# least one special character. The address is not configurable.
DATASPOKE_PROD_ADMIN_PASSWORD=


# ==============================================================================
# 4. LLM Inference  (DATASPOKE_PROD_LLM_*)
# ==============================================================================
# Not chart values: applied AFTER the install into the runtime_config row by
#   ENV_FILE=helm-charts/.env.prod bash helm-charts/bin/post-install/seed-runtime-config.sh
# which PATCHes /internal/admin/conf; the API routes the key into
# dataspoke-llm-secret itself, so do not pre-create that Secret.
#
# Provider and model are needed together — the inference loop cannot route a
# provider alone. Until all three are set, every LLM-backed feature (ontology
# generation, metadata generation, LLM validation) fails at first use. The
# pre-flight stops on an incomplete block unless you pass
# --skip-postinstall-check.
DATASPOKE_PROD_LLM_PROVIDER=
DATASPOKE_PROD_LLM_MODEL=
DATASPOKE_PROD_LLM_API_KEY=


# ==============================================================================
# 5. Peripheral Connections  (DATASPOKE_PROD_PERIPHERAL_*)
# ==============================================================================
# Applied AFTER the install by
#   ENV_FILE=helm-charts/.env.prod bash helm-charts/bin/post-install/seed-peripheral-config.sh
# which PATCHes /internal/admin/peripherals/{datahub,langfuse}. Each suffix is
# the API contract field it carries, upper-cased (see the schemas in
# src/api/schemas/admin.py), so there is no translation table to drift.
#
# The secret fields ride inside those PATCHes and the API writes them into
# dataspoke-datahub-secret / dataspoke-langfuse-secret itself — do NOT
# pre-create those Secrets. An empty value is a "leave unchanged", never a
# clearing write, so re-running the seed after filling one line in is safe.

# --- DataHub ------------------------------------------------------------------
# gms_url addresses the GMS service (what the API connects to); frontend_url is
# the browser-facing UI the frontend deep-links to. They differ in host, port
# and scheme in most deployments and neither is derivable from the other.
# DataHub is the metadata SSOT every DataSpoke feature reads, so until this
# block is seeded those features report the peripheral's absence rather than
# working. The pre-flight stops on an incomplete block unless you pass
# --skip-postinstall-check.
DATASPOKE_PROD_PERIPHERAL_DATAHUB_GMS_URL=
DATASPOKE_PROD_PERIPHERAL_DATAHUB_FRONTEND_URL=
# DataHub personal access token. Every DataHub read and write is rejected by GMS
# without one.
DATASPOKE_PROD_PERIPHERAL_DATAHUB_TOKEN=
# Optional, both with peripheral defaults: the corpuser DataSpoke's own writes
# are attributed to, and the DataHub environment (fabric) new URNs are minted
# under.
DATASPOKE_PROD_PERIPHERAL_DATAHUB_SERVICE_CORPUSER_URN=
DATASPOKE_PROD_PERIPHERAL_DATAHUB_DEFAULT_ENV=

# --- DataHub Kafka (event consumer only) --------------------------------------
# Needed only when your overlay sets `event-consumer.enabled: true` — the chart
# default is false, and a deployment that never runs the consumer is not asked
# for brokers it never uses. The API cross-validates these six as a SET, not
# field by field, so which of them you fill in follows from the security
# posture:
#
#   PLAINTEXT                        brokers only
#   SSL                              brokers, protocol — no mechanism, which the
#                                    API rejects outside the SASL_* protocols
#   SASL_SSL + AWS_MSK_IAM           brokers, protocol, mechanism — and NO
#                                    username or password: the consumer
#                                    authenticates as its ServiceAccount's IAM
#                                    role. Region is optional; blank derives it
#                                    from the broker hostnames, and a value you
#                                    supply must agree with what they encode
#   SASL_SSL / SASL_PLAINTEXT with   brokers, protocol, mechanism, username,
#   a typed mechanism                password
#
# spec/API.md §DataHub Kafka security carries the complete rule set.
DATASPOKE_PROD_PERIPHERAL_DATAHUB_KAFKA_BROKERS=
DATASPOKE_PROD_PERIPHERAL_DATAHUB_KAFKA_SECURITY_PROTOCOL=
DATASPOKE_PROD_PERIPHERAL_DATAHUB_KAFKA_SASL_MECHANISM=
DATASPOKE_PROD_PERIPHERAL_DATAHUB_KAFKA_SASL_USERNAME=
DATASPOKE_PROD_PERIPHERAL_DATAHUB_KAFKA_SASL_PASSWORD=
DATASPOKE_PROD_PERIPHERAL_DATAHUB_KAFKA_AWS_REGION=

# --- Langfuse (LLM observability) ---------------------------------------------
# Optional throughout: an incomplete block disables tracing and nothing else, so
# the pre-flight only warns. Which is exactly why it gets forgotten.
DATASPOKE_PROD_PERIPHERAL_LANGFUSE_HOST=
DATASPOKE_PROD_PERIPHERAL_LANGFUSE_PUBLIC_KEY=
DATASPOKE_PROD_PERIPHERAL_LANGFUSE_SECRET_KEY=
DATASPOKE_PROD_PERIPHERAL_LANGFUSE_PROJECT_ID=
DATASPOKE_PROD_PERIPHERAL_LANGFUSE_ENVIRONMENT_TAG=

# --- SMTP is deliberately absent ----------------------------------------------
# SMTP is set with PATCH /api/v1/admin/peripherals/smtp against the running
# deployment and no install step needs it, so it stays out of this file rather
# than being carried here for symmetry.
