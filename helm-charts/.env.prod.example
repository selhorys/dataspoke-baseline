# DataSpoke prod operator inputs — deployment shape only.
# All credentials are managed via K8s Secrets (operator-pre-created, referenced
# by name via `secrets.existingSecret: <name>` in your values overlay).
# See spec/feature/HELM_CHART.md §Configuration Flow.

DATASPOKE_KUBE_CLUSTER=<prod-cluster-context>
DATASPOKE_KUBE_DATASPOKE_NAMESPACE=dataspoke

# Prod always uses the operator's existing ingress controller.
DATASPOKE_KUBE_INGRESS_MODE=shared
# Currently the only supported value is `nginx` — DataSpoke's Ingress resources
# hardcode this class. In shared mode the install verifies the class exists.
DATASPOKE_KUBE_INGRESS_CLASS=nginx
DATASPOKE_KUBE_INGRESS_DOMAIN=<your-domain>

# Image-build dispatch: GCP (Cloud Build), AWS (ECR + local Docker), or empty
# (local Docker). Shared/EKS prod typically uses AWS.
DATASPOKE_KUBE_CLOUD_VENDOR=GCP
DATASPOKE_KUBE_IMAGE_REGISTRY=<your-registry>
# AWS only (required when CLOUD_VENDOR=AWS): CLI profile for ECR auth/repo
# creation, and whether docker needs sudo.
# DATASPOKE_AWS_PROFILE=<your-profile>
# DATASPOKE_DOCKER_SUDO=false
