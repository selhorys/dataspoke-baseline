# ==============================================================================
# DataSpoke Environment Variables
# ==============================================================================
# Four-tier naming:
#   DATASPOKE_KUBE_*  — Kubernetes deployment shape (read by helm-charts/bin/*.sh; both profiles)
#   DATASPOKE_DEV_*   — dev-profile operator inputs (peripherals, seeding, dummy data)
#   DATASPOKE_DEV_*  — laptop-side test access (auto-populated by install.sh post-install;
#                       read by tests/integration/{conftest.py,util/*}; never read by app pods)
#   DATASPOKE_*       — application runtime (read by DataSpoke app code via K8s ConfigMap/Secret;
#                       both profiles; not present in this file)
#
# Sections:
#   1. Operator inputs — Kubernetes deployment shape  (DATASPOKE_KUBE_*)
#   2. Dev profile inputs  (DATASPOKE_DEV_*)
#   3. Auto-populated by install.sh — DO NOT EDIT  (DATASPOKE_DEV_* + INGRESS_*)
# ==============================================================================


# ==============================================================================
# 1. Operator Inputs — Kubernetes Deployment Shape  (DATASPOKE_KUBE_*)
# ==============================================================================
# Read by helm-charts/bin/*.sh scripts. Same convention in both profiles;
# values differ between dev and prod.

# --- Cluster context ----------------------------------------------------------
# Run `kubectl config get-contexts` to list available contexts.
DATASPOKE_KUBE_CLUSTER=gke-dev-env-02

# --- Namespace ----------------------------------------------------------------
DATASPOKE_KUBE_DATASPOKE_NAMESPACE=dataspoke-01

# --- Ingress mode -------------------------------------------------------------
# DATASPOKE_KUBE_INGRESS_MODE: how the ingress controller is provided.
#   managed — install & own an nginx-ingress controller + LoadBalancer; the IP
#             and <IP>.nip.io domain are auto-derived (GKE/minikube default).
#   shared  — reuse a pre-existing cluster ingress controller. No install, no
#             LoadBalancer IP. You MUST pre-set DATASPOKE_KUBE_INGRESS_DOMAIN
#             (in the auto-populated section below) to a domain the cluster
#             publishes (e.g. via external-dns, e.g. dataspoke-dev.your-host.com),
#             and DATASPOKE_KUBE_INGRESS_CLASS to the controller's IngressClass.
#             TCP services (Postgres/Redis/Kafka/lock) are not exposed via the
#             shared controller — reach them on 127.0.0.1 with bin/port-forward.sh.
DATASPOKE_KUBE_INGRESS_MODE=managed
# DATASPOKE_KUBE_INGRESS_CLASS: the IngressClass every DataSpoke Ingress binds
# to — the umbrella chart's API/frontend/Airflow ingresses, the DataHub frontend
# and Langfuse peripheral charts, and the DataHub GMS manifest. The install
# passes it by `--set`/substitution, so it outranks any `className` in a values
# file. In managed mode it is also the class name the owned nginx-ingress
# controller registers; in shared mode the install checks the class exists.
DATASPOKE_KUBE_INGRESS_CLASS=nginx

# DATASPOKE_KUBE_INGRESS_SCHEME: URL scheme for every ingress-domain-based URL
# the dev install path builds (frontend config, src/frontend/.env.local
# NEXT_PUBLIC_* vars, the post-login redirect, the DataHub OIDC base,
# post-install seed endpoints, health-check.sh probes, the host-bearing
# DATASPOKE_DEV_* URLs, and printed access URLs). IP:port TCP endpoints
# (dev-lock, Kafka, Postgres) bypass the ingress and never take this scheme.
#   http  (default, both modes) — the typical managed-mode nip.io setup.
#   https — set this when a shared-mode controller terminates TLS in front of
#           the virtual hosts (e.g. AWS/EKS behind an ALB), since a
#           TLS-terminating controller emits HSTS and an http page would break
#           under browser mixed-content/auto-upgrade. Changing the scheme
#           changes the Google OAuth redirect URI the dev DataHub OIDC login
#           registers — re-register the matching URI with the operator.
DATASPOKE_KUBE_INGRESS_SCHEME=http

# DATASPOKE_KUBE_INGRESS_TLS_SECRET: optional, default empty. When set, the
# dev install emits a `tls:` block referencing this Kubernetes TLS Secret on
# the three dev ingresses DataSpoke owns (API, frontend subchart, Airflow
# chart-native). Leave empty when the shared controller terminates TLS with a
# controller-level or wildcard cert (e.g. behind an ALB) — per-Ingress TLS
# config is then unnecessary. Orthogonal to DATASPOKE_KUBE_INGRESS_SCHEME: the
# scheme governs the URLs the install builds, this governs whether the
# Ingresses themselves carry TLS.
DATASPOKE_KUBE_INGRESS_TLS_SECRET=

# --- Cloud Vendor & Image Registry --------------------------------------------
# DATASPOKE_KUBE_CLOUD_VENDOR: GCP or AWS. Controls remote image build method.
#   GCP   → gcloud builds submit (no local Docker required)
#   AWS   → ECR login (DATASPOKE_AWS_PROFILE) + ensure-repository + local docker
#           build + push (requires Docker daemon + aws CLI)
#   empty → local Docker build + push (requires Docker daemon)
DATASPOKE_KUBE_CLOUD_VENDOR=GCP
DATASPOKE_KUBE_IMAGE_REGISTRY=<asia-northeast3-docker.pkg.dev/your-project-id/dataspoke>
# AWS only: CLI profile for ECR auth/repo creation, and whether docker needs sudo.
# DATASPOKE_DOCKER_SUDO=true runs docker as root, so the ECR login credential is
# cached under root's ~/.docker/config.json (broader read surface on a shared host).
DATASPOKE_AWS_PROFILE=<your-profile>
DATASPOKE_DOCKER_SUDO=false


# ==============================================================================
# 2. Dev Profile Inputs  (DATASPOKE_DEV_*)
# ==============================================================================
# Operator-supplied inputs for the dev peripheral install. Application pods
# never read these.

# --- Dev: Peripheral Namespaces -----------------------------------------------
DATASPOKE_DEV_KUBE_DATAHUB_NAMESPACE=datahub-01
DATASPOKE_DEV_KUBE_LANGFUSE_NAMESPACE=langfuse-01
DATASPOKE_DEV_KUBE_DUMMY_DATA_NAMESPACE=dataspoke-dummy-data-01

# --- Dev: Helm Chart Versions ------------------------------------------------
DATASPOKE_DEV_KUBE_DATAHUB_PREREQUISITES_CHART_VERSION=0.3.0
DATASPOKE_DEV_KUBE_DATAHUB_CHART_VERSION=1.0.1

# --- Dev: LLM API key and provider -------------------------------------------
# Read by helm-charts/bin/install.sh to populate dataspoke-llm-secret and PATCH
# /internal/admin/conf. The app reads LLM provider/model from the DB runtime
# config; the key is read at runtime from the dataspoke-llm-secret K8s Secret.
# Provider: gemini, openai, anthropic, azure
DATASPOKE_DEV_LLM_PROVIDER=gemini
DATASPOKE_DEV_LLM_API_KEY=<your-api-key>
DATASPOKE_DEV_LLM_MODEL=gemini-3.5-flash

# --- Dev: DataHub MySQL Credentials ------------------------------------------
# Generate secure passwords: 16+ chars, mixed case, at least one special character.
# Example: openssl rand -base64 16 | tr '+/' '-_'
DATASPOKE_DEV_DATAHUB_MYSQL_ROOT_PASSWORD=<replace-with-secure-password>
DATASPOKE_DEV_DATAHUB_MYSQL_PASSWORD=<replace-with-secure-password>

# --- Dev: Dummy Data Source Credentials --------------------------------------
DATASPOKE_DEV_DUMMY_DATA_KAFKA_INSTANCE=example_kafka
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_USER=postgres
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_PASSWORD=ExampleDev2024!
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_DB=example_db

# --- Dev: Langfuse subsystem internals (auto-populated on first install) ------
# auto-populated by langfuse.sh → openssl rand
DATASPOKE_DEV_LANGFUSE_INIT_USER_PASSWORD=            # auto-populated → openssl rand -base64 24 | cut -c1-20
DATASPOKE_DEV_LANGFUSE_NEXTAUTH_SECRET=               # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_SALT=                          # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_ENCRYPTION_KEY=               # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_CLICKHOUSE_PASSWORD=          # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_MINIO_ROOT_USER=minio
DATASPOKE_DEV_LANGFUSE_MINIO_ROOT_PASSWORD=          # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_POSTGRES_PASSWORD=            # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_REDIS_PASSWORD=               # auto-populated → openssl rand -hex 32

# --- Dev: Google OAuth credentials -------------------------------------------
# Used by install.sh to populate dataspoke-secrets (DATASPOKE_GOOGLE_OAUTH_CLIENT_SECRET)
# and to pass auth.googleClientId into the Helm chart. When absent, Google OAuth
# is disabled on both DataSpoke and DataHub — the /auth/google/* routes 302 to the
# UI's /oauth-error page with error=OAUTH_NOT_CONFIGURED, and DataHub falls back to
# native login.
# The DATASPOKE_OAUTH_STATE_SECRET HMAC key is auto-generated by install.sh per
# install; it is not sourced from .env.
DATASPOKE_DEV_GOOGLE_OAUTH_CLIENT_ID=
DATASPOKE_DEV_GOOGLE_OAUTH_CLIENT_SECRET=

# --- Dev: Test harness -------------------------------------------------------
# Set by outer wrappers that already hold the dev-env lock.
# DATASPOKE_DEV_LOCK_PREACQUIRED=


# ==============================================================================
# 3. Auto-Populated by install.sh — DO NOT EDIT
# ==============================================================================
# Written back to this file by install.sh post-install. Tests and dev tooling
# source these for laptop-side access to in-cluster services via ingress.
# App pods never read DATASPOKE_DEV_* from this file — they read DATASPOKE_* from the
# in-cluster ConfigMap/Secret (dataspoke-secrets).

# --- nginx-ingress (auto-populated by bin/dev-peripherals/nginx-ingress.sh) ------
# managed mode: both auto-populated (IP from the LoadBalancer, domain = <IP>.nip.io).
# shared mode:  leave INGRESS_IP blank and PRE-SET INGRESS_DOMAIN to a domain the
#               cluster publishes (e.g. dataspoke-dev.your-host.com).
DATASPOKE_KUBE_INGRESS_IP=                            # auto-populated (managed) / blank (shared)
DATASPOKE_KUBE_INGRESS_DOMAIN=                        # auto-populated → <IP>.nip.io (managed) / operator-set (shared)

# --- DataSpoke subsystem access (auto-populated by install.sh _sync_env_from_secret / _read_configmap_value) ---
DATASPOKE_DEV_POSTGRES_HOST=                         # auto-populated → <INGRESS_IP> (managed) / 127.0.0.1 (shared)
DATASPOKE_DEV_POSTGRES_PORT=9201
DATASPOKE_DEV_POSTGRES_USER=                         # auto-populated → from the dataspoke-app-config ConfigMap
DATASPOKE_DEV_POSTGRES_PASSWORD=                     # auto-populated → from dataspoke-secrets
DATASPOKE_DEV_POSTGRES_DB=                           # auto-populated → from the dataspoke-app-config ConfigMap

DATASPOKE_DEV_REDIS_HOST=                            # auto-populated → <INGRESS_IP> (managed) / 127.0.0.1 (shared)
DATASPOKE_DEV_REDIS_PORT=9202
DATASPOKE_DEV_REDIS_PASSWORD=                        # auto-populated → from dataspoke-secrets

DATASPOKE_DEV_AIRFLOW_URL=                           # auto-populated → http://airflow.<DOMAIN>
DATASPOKE_DEV_AIRFLOW_USER=                          # auto-populated → from dataspoke-secrets
DATASPOKE_DEV_AIRFLOW_PASSWORD=                      # auto-populated → from dataspoke-secrets

DATASPOKE_DEV_INTERNAL_TOKEN=                        # auto-populated → from dataspoke-secrets
DATASPOKE_DEV_JWT_SECRET_KEY=                        # auto-populated → from dataspoke-secrets; conftest promotes it to DATASPOKE_JWT_SECRET_KEY so locally-minted JWTs verify against the API pod

# --- DataHub access (auto-populated by bin/dev-peripherals/datahub.sh) -----------
DATASPOKE_DEV_DATAHUB_GMS_URL=                       # auto-populated → http://datahub-gms.<DOMAIN>
DATASPOKE_DEV_DATAHUB_TOKEN=                         # auto-populated → PAT created by datahub.sh
DATASPOKE_DEV_DATAHUB_KAFKA_BROKERS=                # auto-populated → <INGRESS_IP>:9005 (managed) / 127.0.0.1:9005 (shared)

# --- DataHub peripheral metadata (optional operator inputs, forwarded to admin API) ---
DATASPOKE_DEV_DATAHUB_SERVICE_CORPUSER_URN=          # optional → e.g. urn:li:corpuser:dataspoke; blank = code default
DATASPOKE_DEV_DATAHUB_DEFAULT_ENV=                   # optional → DataHub fabric/env default, e.g. DEV; blank = code default

# --- Langfuse access (auto-populated by bin/dev-peripherals/langfuse.sh) ---------
DATASPOKE_DEV_LANGFUSE_HOST=                         # auto-populated → http://langfuse.<DOMAIN>
DATASPOKE_DEV_LANGFUSE_PUBLIC_KEY=                  # auto-populated → pk-lf-dataspoke-dev
DATASPOKE_DEV_LANGFUSE_SECRET_KEY=                  # auto-populated → sk-lf-dataspoke-dev-<hex>

# --- Langfuse peripheral metadata (optional operator inputs, forwarded to admin API) ---
DATASPOKE_DEV_LANGFUSE_INIT_PROJECT_ID=dataspoke-project   # Langfuse project id; also created by langfuse.sh and forwarded as peripheral project_id
DATASPOKE_DEV_LANGFUSE_ENVIRONMENT_TAG=              # optional → Langfuse trace environment tag; blank = code default

# --- Dummy data source access ------------------------------------------------
# Laptop-side (POSTGRES_HOST / KAFKA_BROKERS): auto-populated by install.sh.
#   managed mode → LoadBalancer IP (nginx TCP passthrough on :9102 / :9104)
#   shared mode  → 127.0.0.1 (bin/port-forward.sh maps the same ports)
# POSTGRES_PORT: static laptop passthrough port — always 9102 regardless of mode.
# POSTGRES_HOST_PORT: in-cluster cluster-DNS address used by the DataSpoke API
#   pod when constructing ingestion source recipes. Same in both ingress modes
#   because the API always runs in-cluster. Do NOT use for laptop-side access.
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_HOST=             # auto-populated → <INGRESS_IP> (managed) / 127.0.0.1 (shared)
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_PORT=9102
DATASPOKE_DEV_DUMMY_DATA_KAFKA_BROKERS=             # auto-populated → <INGRESS_IP>:9104 (managed) / 127.0.0.1:9104 (shared)
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_HOST_PORT=        # auto-populated → example-postgres.<DUMMY_DATA_NS>.svc.cluster.local:5432

# --- Dev-lock URL ------------------------------------------------------------
# auto-populated by install.sh. In managed mode: http://<INGRESS_IP>:9221.
# In shared mode: http://127.0.0.1:9221 (bin/port-forward.sh).
DATASPOKE_DEV_LOCK_URL=                              # auto-populated → http://<host>:9221
