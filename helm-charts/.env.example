# ==============================================================================
# DataSpoke Environment Variables
# ==============================================================================
# Four-tier naming:
#   DATASPOKE_KUBE_*  — Kubernetes deployment shape (read by helm-charts/bin/*.sh; both profiles)
#   DATASPOKE_DEV_*   — dev-profile operator inputs (peripherals, seeding, dummy data)
#   DATASPOKE_TEST_*  — laptop-side test access (auto-populated by install.sh post-install;
#                       read by tests/integration/{conftest.py,util/*}; never read by app pods)
#   DATASPOKE_*       — application runtime (read by DataSpoke app code via K8s ConfigMap/Secret;
#                       both profiles; not present in this file)
#
# Sections:
#   1. Operator inputs — Kubernetes deployment shape  (DATASPOKE_KUBE_*)
#   2. Dev profile inputs  (DATASPOKE_DEV_*)
#   3. Auto-populated by install.sh — DO NOT EDIT  (DATASPOKE_TEST_* + INGRESS_*)
# ==============================================================================


# ==============================================================================
# 1. Operator Inputs — Kubernetes Deployment Shape  (DATASPOKE_KUBE_*)
# ==============================================================================
# Read by helm-charts/bin/*.sh scripts. Same convention in both profiles;
# values differ between dev and prod.

# --- Cluster context ----------------------------------------------------------
# Run `kubectl config get-contexts` to list available contexts.
DATASPOKE_KUBE_CLUSTER=gke-dev-env-02

# --- Namespace ----------------------------------------------------------------
DATASPOKE_KUBE_DATASPOKE_NAMESPACE=dataspoke-01

# --- Cloud Vendor & Image Registry --------------------------------------------
# DATASPOKE_KUBE_CLOUD_VENDOR: GCP or AWS. Controls remote image build method.
#   GCP → gcloud builds submit (no local Docker needed)
#   AWS → TODO (not yet implemented)
#   empty → local Docker build + push (requires Docker daemon)
DATASPOKE_KUBE_CLOUD_VENDOR=GCP
DATASPOKE_KUBE_IMAGE_REGISTRY=<asia-northeast3-docker.pkg.dev/your-project-id/dataspoke>


# ==============================================================================
# 2. Dev Profile Inputs  (DATASPOKE_DEV_*)
# ==============================================================================
# Operator-supplied inputs for the dev peripheral install. Application pods
# never read these.

# --- Dev: Peripheral Namespaces -----------------------------------------------
DATASPOKE_DEV_KUBE_DATAHUB_NAMESPACE=datahub-01
DATASPOKE_DEV_KUBE_LANGFUSE_NAMESPACE=langfuse-01
DATASPOKE_DEV_KUBE_DUMMY_DATA_NAMESPACE=dataspoke-dummy-data-01

# --- Dev: Helm Chart Versions ------------------------------------------------
DATASPOKE_DEV_KUBE_DATAHUB_PREREQUISITES_CHART_VERSION=0.3.0
DATASPOKE_DEV_KUBE_DATAHUB_CHART_VERSION=1.0.1

# --- Dev: LLM API key and provider -------------------------------------------
# Read by helm-charts/bin/install.sh to populate dataspoke-llm-secret and PATCH
# /internal/admin/conf. The app reads LLM provider/model from the DB runtime
# config; the key is read at runtime from the dataspoke-llm-secret K8s Secret.
# Provider: gemini, openai, anthropic, azure
DATASPOKE_DEV_LLM_PROVIDER=gemini
DATASPOKE_DEV_LLM_API_KEY=<your-api-key>
DATASPOKE_DEV_LLM_MODEL=gemini-3.5-flash

# --- Dev: DataHub MySQL Credentials ------------------------------------------
# Generate secure passwords: 16+ chars, mixed case, at least one special character.
# Example: openssl rand -base64 16 | tr '+/' '-_'
DATASPOKE_DEV_DATAHUB_MYSQL_ROOT_PASSWORD=<replace-with-secure-password>
DATASPOKE_DEV_DATAHUB_MYSQL_PASSWORD=<replace-with-secure-password>

# --- Dev: Dummy Data Source Credentials --------------------------------------
DATASPOKE_DEV_DUMMY_DATA_KAFKA_INSTANCE=example_kafka
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_USER=postgres
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_PASSWORD=ExampleDev2024!
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_DB=example_db

# --- Dev: Langfuse subsystem internals (auto-populated on first install) ------
# auto-populated by langfuse.sh → openssl rand
DATASPOKE_DEV_LANGFUSE_INIT_USER_PASSWORD=            # auto-populated → openssl rand -base64 24 | cut -c1-20
DATASPOKE_DEV_LANGFUSE_NEXTAUTH_SECRET=               # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_SALT=                          # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_ENCRYPTION_KEY=               # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_CLICKHOUSE_PASSWORD=          # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_MINIO_ROOT_USER=minio
DATASPOKE_DEV_LANGFUSE_MINIO_ROOT_PASSWORD=          # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_POSTGRES_PASSWORD=            # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_REDIS_PASSWORD=               # auto-populated → openssl rand -hex 32

# --- Dev: Google OAuth credentials -------------------------------------------
# Used by install.sh to populate dataspoke-secrets (DATASPOKE_GOOGLE_OAUTH_CLIENT_SECRET)
# and to pass auth.googleClientId into the Helm chart. When absent, Google OAuth
# is disabled on both DataSpoke and DataHub — the API returns 503 OAUTH_NOT_CONFIGURED
# and DataHub falls back to native login.
# The DATASPOKE_OAUTH_STATE_SECRET HMAC key is auto-generated by install.sh per
# install; it is not sourced from .env.
DATASPOKE_DEV_GOOGLE_OAUTH_CLIENT_ID=
DATASPOKE_DEV_GOOGLE_OAUTH_CLIENT_SECRET=

# --- Dev: Test harness -------------------------------------------------------
# Set by outer wrappers that already hold the dev-env lock.
# DATASPOKE_DEV_ENV_LOCK_PREACQUIRED=


# ==============================================================================
# 3. Auto-Populated by install.sh — DO NOT EDIT
# ==============================================================================
# Written back to this file by install.sh post-install. Tests and dev tooling
# source these for laptop-side access to in-cluster services via ingress.
# App pods never read DATASPOKE_TEST_* from this file — they read DATASPOKE_* from the
# in-cluster ConfigMap/Secret (dataspoke-secrets).

# --- nginx-ingress (auto-populated by bin/peripherals/nginx-ingress.sh) ------
DATASPOKE_KUBE_INGRESS_IP=                            # auto-populated → LoadBalancer external IP
DATASPOKE_KUBE_INGRESS_DOMAIN=                        # auto-populated → <IP>.nip.io

# --- DataSpoke subsystem access (auto-populated by install.sh _sync_env_from_secret) ---
DATASPOKE_TEST_POSTGRES_HOST=                         # auto-populated → <INGRESS_IP>
DATASPOKE_TEST_POSTGRES_PORT=9201
DATASPOKE_TEST_POSTGRES_USER=                         # auto-populated → from dataspoke-secrets
DATASPOKE_TEST_POSTGRES_PASSWORD=                     # auto-populated → from dataspoke-secrets
DATASPOKE_TEST_POSTGRES_DB=                           # auto-populated → from dataspoke-secrets

DATASPOKE_TEST_REDIS_HOST=                            # auto-populated → <INGRESS_IP>
DATASPOKE_TEST_REDIS_PORT=9202
DATASPOKE_TEST_REDIS_PASSWORD=                        # auto-populated → from dataspoke-secrets

DATASPOKE_TEST_AIRFLOW_URL=                           # auto-populated → http://airflow.<DOMAIN>
DATASPOKE_TEST_AIRFLOW_USER=                          # auto-populated → from dataspoke-secrets
DATASPOKE_TEST_AIRFLOW_PASSWORD=                      # auto-populated → from dataspoke-secrets

DATASPOKE_TEST_INTERNAL_TOKEN=                        # auto-populated → from dataspoke-secrets
DATASPOKE_TEST_JWT_SECRET_KEY=                        # auto-populated → from dataspoke-secrets; conftest promotes it to DATASPOKE_JWT_SECRET_KEY so locally-minted JWTs verify against the API pod

# --- DataHub access (auto-populated by bin/peripherals/datahub.sh) -----------
DATASPOKE_TEST_DATAHUB_GMS_URL=                       # auto-populated → http://datahub.<DOMAIN>/gms
DATASPOKE_TEST_DATAHUB_TOKEN=                         # auto-populated → PAT created by datahub.sh
DATASPOKE_TEST_DATAHUB_KAFKA_BROKERS=                # auto-populated → <INGRESS_IP>:9005

# --- Langfuse access (auto-populated by bin/peripherals/langfuse.sh) ---------
DATASPOKE_TEST_LANGFUSE_HOST=                         # auto-populated → http://langfuse.<DOMAIN>
DATASPOKE_TEST_LANGFUSE_PUBLIC_KEY=                  # auto-populated → pk-lf-dataspoke-dev
DATASPOKE_TEST_LANGFUSE_SECRET_KEY=                  # auto-populated → sk-lf-dataspoke-dev-<hex>

# --- Dummy data source access (via ingress TCP passthrough) ------------------
DATASPOKE_TEST_DUMMY_DATA_POSTGRES_HOST=             # auto-populated → <INGRESS_IP>
DATASPOKE_TEST_DUMMY_DATA_POSTGRES_PORT=9102
DATASPOKE_TEST_DUMMY_DATA_KAFKA_BROKERS=             # auto-populated → <INGRESS_IP>:9104
