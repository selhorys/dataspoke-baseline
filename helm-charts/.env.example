# ==============================================================================
# DataSpoke Environment Variables
# ==============================================================================
# Three-tier naming:
#   DATASPOKE_*       — application runtime (read by DataSpoke app code; both profiles)
#   DATASPOKE_KUBE_*  — Kubernetes deployment (read by helm-charts/bin/*.sh; both profiles)
#   DATASPOKE_DEV_*   — dev-profile only (peripherals, seeding, dummy data)
#
# Sections:
#   1. Application runtime  (DATASPOKE_*)
#   2. Kubernetes deployment  (DATASPOKE_KUBE_*)
#   3. Dev profile  (DATASPOKE_DEV_*)
# ==============================================================================


# ==============================================================================
# 1. Application Runtime  (DATASPOKE_*)
# ==============================================================================
# Same names in dev and prod — different values.
# In dev, helm-charts/bin/peripherals/nginx-ingress.sh auto-populates the
# variables marked "auto-populated" below from DATASPOKE_KUBE_INGRESS_IP / _DOMAIN.
# In prod, these are injected via Helm values → K8s ConfigMap/Secret.

# --- Application Ports --------------------------------------------------------
DATASPOKE_API_PORT=8002

# --- PostgreSQL (DataSpoke operational DB) ------------------------------------
DATASPOKE_POSTGRES_HOST=                          # auto-populated → <IP>
DATASPOKE_POSTGRES_PORT=9201
DATASPOKE_POSTGRES_USER=dataspoke
DATASPOKE_POSTGRES_PASSWORD=<replace-with-secure-password>
DATASPOKE_POSTGRES_DB=dataspoke

# --- Redis --------------------------------------------------------------------
DATASPOKE_REDIS_HOST=                             # auto-populated → <IP>
DATASPOKE_REDIS_PORT=9202
DATASPOKE_REDIS_PASSWORD=<replace-with-secure-password>

# --- Airflow ------------------------------------------------------------------
# IMPORTANT: The Airflow UI is reachable via public nip.io ingress.
# Set a strong, unique password — install.sh will abort if the value is
# empty or literally "admin".
DATASPOKE_AIRFLOW_URL=                            # auto-populated → http://airflow.<DOMAIN>
DATASPOKE_AIRFLOW_USER=<replace-with-airflow-username>
DATASPOKE_AIRFLOW_PASSWORD=<replace-with-secure-password>
DATASPOKE_AIRFLOW_CALLBACK_BASE_URL=http://dataspoke-api:8002

# --- Internal Auth ------------------------------------------------------------
# Shared secret for Airflow→API internal calls. Must match in both environments.
# In dev, helm-charts/bin/install.sh auto-generates this and appends it back to
# this .env, then mounts it on the API pod via the dataspoke-internal-auth K8s Secret.
# Generate manually with: openssl rand -hex 32
DATASPOKE_INTERNAL_TOKEN=


# ==============================================================================
# 2. Kubernetes Deployment  (DATASPOKE_KUBE_*)
# ==============================================================================
# Read by helm-charts/bin/*.sh scripts. Same convention in both profiles;
# values differ between dev and prod.

# --- Cluster context ----------------------------------------------------------
# Run `kubectl config get-contexts` to list available contexts.
DATASPOKE_KUBE_CLUSTER=gke-dev-env-02

# --- Namespace ----------------------------------------------------------------
DATASPOKE_KUBE_DATASPOKE_NAMESPACE=dataspoke-01

# --- Cloud Vendor & Image Registry --------------------------------------------
# DATASPOKE_KUBE_CLOUD_VENDOR: GCP or AWS. Controls remote image build method.
#   GCP → gcloud builds submit (no local Docker needed)
#   AWS → TODO (not yet implemented)
#   empty → local Docker build + push (requires Docker daemon)
DATASPOKE_KUBE_CLOUD_VENDOR=GCP
DATASPOKE_KUBE_IMAGE_REGISTRY=<asia-northeast3-docker.pkg.dev/your-project-id/dataspoke>

# --- nginx-ingress (auto-populated by helm-charts/bin/peripherals/nginx-ingress.sh) ---
DATASPOKE_KUBE_INGRESS_IP=
DATASPOKE_KUBE_INGRESS_DOMAIN=


# ==============================================================================
# 3. Dev Profile  (DATASPOKE_DEV_*)
# ==============================================================================
# Read only by dev peripheral and seeding scripts. Application pods never read
# these. All are dev-only — not present in prod deployments.

# --- Dev: Peripheral Namespaces -----------------------------------------------
DATASPOKE_DEV_KUBE_DATAHUB_NAMESPACE=datahub-01
DATASPOKE_DEV_KUBE_LANGFUSE_NAMESPACE=langfuse-01
DATASPOKE_DEV_KUBE_DUMMY_DATA_NAMESPACE=dataspoke-dummy-data-01

# --- Dev: Helm Chart Versions ------------------------------------------------
DATASPOKE_DEV_KUBE_DATAHUB_PREREQUISITES_CHART_VERSION=0.3.0
DATASPOKE_DEV_KUBE_DATAHUB_CHART_VERSION=0.9.10

# --- Dev: LLM API key and provider -------------------------------------------
# Read by helm-charts/bin/install.sh to populate dataspoke-llm-secret and PATCH
# /internal/admin/conf. The app reads LLM provider/model from the DB runtime
# config; the key is read at runtime from the dataspoke-llm-secret K8s Secret.
# Provider: gemini, openai, anthropic, azure
DATASPOKE_DEV_LLM_PROVIDER=gemini
DATASPOKE_DEV_LLM_API_KEY=<your-api-key>
DATASPOKE_DEV_LLM_MODEL=gemini-3.5-flash

# --- Dev: DataHub MySQL Credentials ------------------------------------------
# Generate secure passwords: 16+ chars, mixed case, at least one special character.
# Example: openssl rand -base64 16 | tr '+/' '-_'
DATASPOKE_DEV_DATAHUB_MYSQL_ROOT_PASSWORD=<replace-with-secure-password>
DATASPOKE_DEV_DATAHUB_MYSQL_PASSWORD=<replace-with-secure-password>

# --- Dev: DataHub connection (auto-populated by bin/peripherals/datahub.sh) ---
DATASPOKE_DEV_DATAHUB_GMS_URL=                   # auto-populated → http://datahub-datahub-gms.<NS>.svc.cluster.local:8080
DATASPOKE_DEV_DATAHUB_TOKEN=                      # auto-populated → PAT created by datahub.sh
DATASPOKE_DEV_DATAHUB_KAFKA_BROKERS=             # auto-populated → datahub-prerequisites-kafka.<NS>.svc.cluster.local:9092

# --- Dev: Langfuse connection (auto-populated by bin/peripherals/langfuse.sh) ---
DATASPOKE_DEV_LANGFUSE_HOST=                      # auto-populated → http://langfuse.<DOMAIN>
DATASPOKE_DEV_LANGFUSE_PUBLIC_KEY=               # auto-populated → pk-lf-dataspoke-dev
DATASPOKE_DEV_LANGFUSE_SECRET_KEY=               # auto-populated → sk-lf-dataspoke-dev-<openssl-hex>

# --- Dev: Langfuse subsystem internals (auto-populated on first install) ------
# auto-populated by langfuse.sh → openssl rand
DATASPOKE_DEV_LANGFUSE_INIT_USER_PASSWORD=            # auto-populated → openssl rand -base64 24 | cut -c1-20
DATASPOKE_DEV_LANGFUSE_NEXTAUTH_SECRET=               # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_SALT=                          # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_ENCRYPTION_KEY=               # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_CLICKHOUSE_PASSWORD=          # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_MINIO_ROOT_USER=minio
DATASPOKE_DEV_LANGFUSE_MINIO_ROOT_PASSWORD=          # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_POSTGRES_PASSWORD=            # auto-populated → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_REDIS_PASSWORD=               # auto-populated → openssl rand -hex 32

# --- Dev: Dummy Data Kafka Instance -------------------------------------------
DATASPOKE_DEV_DUMMY_DATA_KAFKA_INSTANCE=example_kafka

# --- Dev: Dummy Data Source Credentials --------------------------------------
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_USER=postgres
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_PASSWORD=ExampleDev2024!
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_DB=example_db

# --- Dev: Dummy Data Source Access (via ingress TCP passthrough) -------------
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_HOST=          # auto-populated → <IP>
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_PORT=9102
DATASPOKE_DEV_DUMMY_DATA_KAFKA_BROKERS=          # auto-populated → <IP>:9104

# --- Dev: Test harness -------------------------------------------------------
# Set by outer wrappers that already hold the dev-env lock.
# DATASPOKE_DEV_ENV_LOCK_PREACQUIRED=
