# ==============================================================================
# DataSpoke Environment Variables
# ==============================================================================
# Two-tier naming:
#   DATASPOKE_*      — application runtime (read by DataSpoke app code)
#   DATASPOKE_DEV_*  — dev environment only (read by dev_env/*.sh scripts)
#
# Layout:
#   1. Application runtime                       (DATASPOKE_*)
#   2. Dev environment                           (DATASPOKE_DEV_*)
#   3. Peripheral systems install config         (DATASPOKE_DEV_{DATAHUB|LANGFUSE}_*)
#   4. Dev dummy data                            (DATASPOKE_DEV_*DUMMY_DATA*)
# ==============================================================================


# ==============================================================================
# 1. Application Runtime  (DATASPOKE_*)
# ==============================================================================
# Same names in dev and prod — different values.
# In dev, nginx-ingress/install.sh auto-populates the variables marked
# "auto-populated" below from DATASPOKE_DEV_INGRESS_IP / _DOMAIN.
# In prod, these are injected via Helm values → K8s ConfigMap/Secret.

# --- Application Ports --------------------------------------------------------
DATASPOKE_API_PORT=8002

# --- PostgreSQL (DataSpoke operational DB) ------------------------------------
DATASPOKE_POSTGRES_HOST=                          # auto-populated → <IP>
DATASPOKE_POSTGRES_PORT=9201
DATASPOKE_POSTGRES_USER=dataspoke
DATASPOKE_POSTGRES_PASSWORD=<replace-with-secure-password>
DATASPOKE_POSTGRES_DB=dataspoke

# --- Redis --------------------------------------------------------------------
DATASPOKE_REDIS_HOST=                             # auto-populated → <IP>
DATASPOKE_REDIS_PORT=9202
DATASPOKE_REDIS_PASSWORD=<replace-with-secure-password>

# --- Airflow ------------------------------------------------------------------
DATASPOKE_AIRFLOW_URL=                            # auto-populated → http://airflow.<DOMAIN>
DATASPOKE_AIRFLOW_USER=admin
DATASPOKE_AIRFLOW_PASSWORD=admin
DATASPOKE_AIRFLOW_CALLBACK_BASE_URL=http://dataspoke-api:8002

# --- Test-mode LLM escape hatch ----------------------------------------------
# When DATASPOKE_TEST_MODE=true and this is true, integration tests bypass
# StubLLMClient and hit the real LLM (key sourced from the dataspoke-llm-secret
# K8s Secret, populated from DATASPOKE_DEV_LLM_API_KEY). Keep false for CI runs.
DATASPOKE_TEST_LLM_REAL=false

# --- Internal Auth ------------------------------------------------------------
# Shared secret for Airflow→API internal calls. Must match in both environments.
# In dev, dataspoke-infra/install.sh auto-generates this and appends it back to
# this .env, then mounts it on the API pod via the dataspoke-internal-auth K8s Secret.
# Generate manually with: openssl rand -hex 32
DATASPOKE_INTERNAL_TOKEN=

# WARNING: Stub auth is for dev/CI only. Setting this to true in production
# bypasses real credential validation and grants full admin/de/da/dg groups
# to anyone who knows DATASPOKE_ADMIN_EMAIL / DATASPOKE_ADMIN_PASSWORD.
# Keep this unset (defaults to false) in any deployment reachable from
# outside your dev laptop / CI runner.
DATASPOKE_ENABLE_STUB_AUTH=true


# ==============================================================================
# 2. Dev Environment  (DATASPOKE_DEV_*)
# ==============================================================================
# Read by dev_env/*.sh scripts only — not by the deployed pod.

# --- Dev: Kubernetes Cluster & Namespaces ------------------------------------
# Cluster context — run `kubectl config get-contexts` to list available contexts.
DATASPOKE_DEV_KUBE_CLUSTER=gke-dev-env-02
DATASPOKE_DEV_KUBE_DATAHUB_NAMESPACE=datahub-01
DATASPOKE_DEV_KUBE_DATASPOKE_NAMESPACE=dataspoke-01
DATASPOKE_DEV_KUBE_LANGFUSE_NAMESPACE=langfuse-01

# --- Dev: Helm Chart Versions ------------------------------------------------
DATASPOKE_DEV_KUBE_DATAHUB_PREREQUISITES_CHART_VERSION=0.3.0
DATASPOKE_DEV_KUBE_DATAHUB_CHART_VERSION=0.9.10

# --- Dev: Cloud Vendor & Image Registry --------------------------------------
# DATASPOKE_DEV_CLOUD_VENDOR: GCP or AWS. Controls remote image build method.
#   GCP → gcloud builds submit (no local Docker needed)
#   AWS → TODO (not yet implemented)
#   empty → local Docker build + push (requires Docker daemon)
DATASPOKE_DEV_CLOUD_VENDOR=GCP
DATASPOKE_DEV_IMAGE_REGISTRY=<asia-northeast3-docker.pkg.dev/your-project-id/dataspoke>

# --- Dev: nginx-ingress (auto-populated by nginx-ingress/install.sh) --------
DATASPOKE_DEV_INGRESS_IP=
DATASPOKE_DEV_INGRESS_DOMAIN=

# --- Dev: LLM API key and provider -------------------------------------------
# These are dev-tier vars (read by install.sh only). The app reads LLM
# provider/model from the DB runtime config (seeded via /api/v1/admin/conf).
# install.sh uses DATASPOKE_DEV_LLM_API_KEY to populate the dataspoke-llm-secret
# K8s Secret and PATCHes provider/model into the runtime config after install.
# Provider: gemini, openai, anthropic, azure
DATASPOKE_DEV_LLM_PROVIDER=gemini
DATASPOKE_DEV_LLM_API_KEY=<your-api-key>
DATASPOKE_DEV_LLM_MODEL=gemini-3.5-flash


# ==============================================================================
# 3. Peripheral Systems Install Config  (DATASPOKE_DEV_{DATAHUB|LANGFUSE}_*)
# ==============================================================================
# Install-time config for DataHub and Langfuse subsystems. NOT read by the
# deployed pod — dataspoke-infra/install.sh reads these to create K8s secrets
# and PATCH /api/v1/internal/admin/peripherals/{datahub,langfuse}. Pod reads
# connection config from the peripheral_config DB table.

# --- Dev: DataHub MySQL Credentials ------------------------------------------
# Generate secure passwords: 16+ chars, mixed case, at least one special character.
# Example: openssl rand -base64 16 | tr '+/' '-_'
DATASPOKE_DEV_DATAHUB_MYSQL_ROOT_PASSWORD=<replace-with-secure-password>
DATASPOKE_DEV_DATAHUB_MYSQL_PASSWORD=<replace-with-secure-password>

# --- Dev: DataHub connection (install-only) -----------------------------------
# Populated by dev_env/datahub/install.sh.
DATASPOKE_DEV_DATAHUB_GMS_URL=                   # auto-populated → http://datahub-datahub-gms.<NS>.svc.cluster.local:8080
DATASPOKE_DEV_DATAHUB_TOKEN=                      # auto-populated → PAT created by datahub/install.sh
DATASPOKE_DEV_DATAHUB_KAFKA_BROKERS=             # auto-populated → datahub-prerequisites-kafka.<NS>.svc.cluster.local:9092

# --- Dev: Langfuse connection (install-only) ----------------------------------
# Populated by dev_env/langfuse/install.sh.
DATASPOKE_DEV_LANGFUSE_HOST=                      # auto-populated → http://langfuse.<DOMAIN>
DATASPOKE_DEV_LANGFUSE_PUBLIC_KEY=               # auto-populated by langfuse/install.sh → pk-lf-dataspoke-dev
DATASPOKE_DEV_LANGFUSE_SECRET_KEY=               # auto-populated by langfuse/install.sh → sk-lf-dataspoke-dev-<openssl-hex>

# --- Dev: Langfuse subsystem internals ---------------------------------------
DATASPOKE_DEV_LANGFUSE_NEXTAUTH_SECRET=               # auto-populated by install.sh → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_SALT=                          # auto-populated by install.sh → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_ENCRYPTION_KEY=               # auto-populated by install.sh → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_CLICKHOUSE_PASSWORD=          # auto-populated by install.sh → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_MINIO_ROOT_USER=minio
DATASPOKE_DEV_LANGFUSE_MINIO_ROOT_PASSWORD=          # auto-populated by install.sh → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_POSTGRES_PASSWORD=            # auto-populated by install.sh → openssl rand -hex 32
DATASPOKE_DEV_LANGFUSE_REDIS_PASSWORD=               # auto-populated by install.sh → openssl rand -hex 32


# ==============================================================================
# 4. Dev Dummy Data
# ==============================================================================

# --- Dev: Dummy Data Namespace & Kafka Instance ------------------------------
DATASPOKE_DEV_KUBE_DUMMY_DATA_NAMESPACE=dataspoke-dummy-data-01
DATASPOKE_DEV_DUMMY_DATA_KAFKA_INSTANCE=example_kafka

# --- Dev: Dummy Data Source Credentials --------------------------------------
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_USER=postgres
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_PASSWORD=ExampleDev2024!
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_DB=example_db

# --- Dev: Dummy Data Source Access (via ingress TCP passthrough) -------------
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_HOST=          # auto-populated → <IP>
DATASPOKE_DEV_DUMMY_DATA_POSTGRES_PORT=9102
DATASPOKE_DEV_DUMMY_DATA_KAFKA_BROKERS=          # auto-populated → <IP>:9104
