# Prauto instance-specific configuration — NEVER commit this file.
# Copy to config.local.env and edit before first run.

# Identity (unique per instance)
PRAUTO_WORKER_ID="prauto01"
PRAUTO_GIT_AUTHOR_NAME="prauto01"
PRAUTO_GIT_AUTHOR_EMAIL="prauto01@dataspoke.local"

# The GitHub login the executor must authenticate as. The executor resolves
# `gh api user` at startup and aborts if it resolves to anything else — this
# pins every comment/label/assignee to the worker account rather than whatever
# the keyring would fall back to. Set it to the bot account's login.
# PRAUTO_GITHUB_EXPECTED_ACTOR="youraccount-prauto"

# Agent selection: claude | codex | auto (default: auto — Claude then Codex).
# Local configuration controls this value. The scheduler does not preset it;
# the executor reads it and falls back to auto when it is unset.
# Codex fresh runs use JSONL to capture the CLI-issued thread id; its resumes
# receive only that id and a prompt. Claude turn/budget settings below are never
# passed to Codex.
# PRAUTO_AGENT="claude"

# Claude Code CLI (tune per instance based on machine capacity)
PRAUTO_CLAUDE_MODEL="sonnet"
# PRAUTO_CLAUDE_EFFORT="high"
# Codex CLI (only used when PRAUTO_AGENT resolves to codex)
# Leave both settings unset to inherit the account's default Codex model and
# reasoning. Set both only when the authenticated account/API environment
# supports `codex exec -m`. Supported model overrides are gpt-5.6,
# gpt-5.6-terra, and gpt-5.6-luna; bare aliases such as "terra" are rejected
# before invocation. Supported effort overrides are low, medium, high, xhigh,
# max, and ultra.
# PRAUTO_CODEX_MODEL="gpt-5.6"
# PRAUTO_CODEX_EFFORT="medium"
PRAUTO_CLAUDE_MAX_TURNS_ANALYSIS=100
PRAUTO_CLAUDE_MAX_TURNS_IMPLEMENTATION=400

# Integration test fix loop: max Claude fix attempts before giving up (default: 10)
PRAUTO_INTEGRATION_FIX_MAX_RETRIES=10
PRAUTO_CLAUDE_MAX_TURNS_INTEGRATION_FIX=200

# Pre-PR integration fix loop only: cap on rerunning a group after a classified
# environmental transport flake (never a worker fix) before giving up without
# dispatching a worker. Separate from and does not consume PRAUTO_INTEGRATION_FIX_MAX_RETRIES.
# PRAUTO_INTEGRATION_FLAKE_RERUNS=2

# E2E stage: total attempts, each costing a frontend rebuild + redeploy (default: 3).
# The fix session runs only on a non-final attempt, so this buys up to 2 fix
# passes before the stage reports its result without further fixing.
PRAUTO_E2E_FIX_MAX_RETRIES=3
# Turn budget for an E2E fix session (default: PRAUTO_CLAUDE_MAX_TURNS_INTEGRATION_FIX)
# PRAUTO_CLAUDE_MAX_TURNS_E2E_FIX=200

# Pre-PR E2E stage only: cap on rerunning the suite after a classified
# environmental transport flake (never a worker fix) before giving up without
# dispatching a worker. Separate from and does not consume PRAUTO_E2E_FIX_MAX_RETRIES.
# PRAUTO_E2E_FLAKE_RERUNS=2

# Post-PR regression runs the full static/unit/spot/api-wired/E2E gate once.
# A failure gets one coding-agent session bounded by
# PRAUTO_CLAUDE_MAX_TURNS_INTEGRATION_FIX, then only the failed stages are
# independently retried against the exact pushed head. There is no second full
# regression cycle and therefore no post-PR retry-count setting.

# Quota check timeout in seconds (default: 45). Increase if dry-run is slow on your network.
# PRAUTO_QUOTA_TIMEOUT=45

# Dev cluster binding. Point this at THIS worker's own dedicated dev-profile cluster's
# env file — prauto provisions, deploys branch images to, and resets that cluster, so a
# shared cluster would collide with a human engineer's work and with other workers.
# A relative path resolves under the repo checkout; an absolute path is used as given.
# The committed default (helm-charts/.env.dev) is the shared human cluster and is safe
# only for single-worker or testing use. Leave unset to inherit that default.
# PRAUTO_DEV_ENV_FILE="helm-charts/.env.dev.prauto01"

# Cluster provisioning (default: true). When the health check is red or the cluster is
# absent, prauto runs a full dev-profile install against PRAUTO_DEV_ENV_FILE before the
# cluster stages. Set to "false" to leave provisioning to a human and skip cluster
# stages on a red check.
# PRAUTO_CLUSTER_PROVISION_ENABLED="true"

# Wall-clock backstop for one full dev-profile provisioning run. Provisioning
# output stays in private, bounded local state logs; a timeout stops its whole
# managed process tree and leaves required cluster tests infrastructure-blocked.
# PRAUTO_PROVISION_TIMEOUT_SECS=3600

# Budget caps (optional — only effective with API billing, ignored on Pro/Max plans)
# PRAUTO_CLAUDE_MAX_BUDGET_ANALYSIS="0.50"
# PRAUTO_CLAUDE_MAX_BUDGET_IMPLEMENTATION="2.00"
# PRAUTO_CLAUDE_MAX_BUDGET_INTEGRATION_FIX="1.00"
# PRAUTO_CLAUDE_MAX_BUDGET_E2E_FIX="1.00"

# Maximum open issues this worker can hold concurrently (default: 1).
# Counts all open issues assigned to this worker with any prauto: label.
# Higher values let the worker pick up new issues while existing ones are pending.
PRAUTO_OPEN_ISSUE_LIMIT=1

# PR reviewer (GitHub login). Set to the human reviewer.
# Leave empty if the repo owner is an org — org names are not valid reviewers.
PRAUTO_REVIEWER=""

# Scheduler (Hermes cron binding) — instance identity. DO NOT COMMIT.
# The local checkout path (the job's workdir) and Hermes delivery setting. The supervisor
# agent reports the trigger and launch status to Slack, then detaches the executor and the
# background monitor, which posts run-scoped Slack notes until the coding agent finishes.
# Machine-specific: override on a fork/another machine.
PRAUTO_SCHEDULER_HERMES_WORKDIR="/path/to/dataspoke-baseline"
PRAUTO_SCHEDULER_HERMES_DELIVER="local"   # or e.g. "telegram"

# Slack reporting resolves the channel target from the Hermes profile home that owns it.
# A cron-launched supervisor inherits the right one; any other launcher (a plain shell, a
# different profile) does not, and a monitor started without it fails its target preflight
# — loudly, with MONITOR_EXITED_IMMEDIATELY from the launcher — instead of reporting into a
# void. Pin it here to make reporting independent of the launching shell:
# PRAUTO_SCHEDULER_HERMES_HOME="/Users/you/.hermes/profiles/<name>"

# Secrets (optional — leave empty to use system auth / keyring credentials)
ANTHROPIC_API_KEY=""
GH_TOKEN=""
