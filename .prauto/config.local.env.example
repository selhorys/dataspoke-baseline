# Prauto instance-specific configuration — NEVER commit this file.
# Copy to config.local.env and edit before first run.

# Identity (unique per instance)
PRAUTO_WORKER_ID="prauto01"
PRAUTO_GIT_AUTHOR_NAME="prauto01"
PRAUTO_GIT_AUTHOR_EMAIL="prauto01@dataspoke.local"

# Claude Code CLI (tune per instance based on machine capacity)
PRAUTO_CLAUDE_MODEL="opus"
PRAUTO_CLAUDE_MAX_TURNS_ANALYSIS=100
PRAUTO_CLAUDE_MAX_TURNS_IMPLEMENTATION=400

# Integration test fix loop: max Claude fix attempts before giving up (default: 10)
PRAUTO_INTEGRATION_FIX_MAX_RETRIES=10
PRAUTO_CLAUDE_MAX_TURNS_INTEGRATION_FIX=200

# E2E stage: total attempts, each costing a frontend rebuild + redeploy (default: 1).
# The fix session runs only on a non-final attempt, so 1 means run once and report
# the result without fixing. Raise it to buy fix attempts.
PRAUTO_E2E_FIX_MAX_RETRIES=1
# Turn budget for an E2E fix session (default: PRAUTO_CLAUDE_MAX_TURNS_INTEGRATION_FIX)
# PRAUTO_CLAUDE_MAX_TURNS_E2E_FIX=200

# Quota check timeout in seconds (default: 45). Increase if dry-run is slow on your network.
# PRAUTO_QUOTA_TIMEOUT=45

# Dev cluster binding. Point this at THIS worker's own dedicated dev-profile cluster's
# env file — prauto provisions, deploys branch images to, and resets that cluster, so a
# shared cluster would collide with a human engineer's work and with other workers.
# A relative path resolves under the repo checkout; an absolute path is used as given.
# The committed default (helm-charts/.env.dev) is the shared human cluster and is safe
# only for single-worker or testing use. Leave unset to inherit that default.
# PRAUTO_DEV_ENV_FILE="helm-charts/.env.dev.prauto01"

# Cluster provisioning (default: true). When the health check is red or the cluster is
# absent, prauto runs a full dev-profile install against PRAUTO_DEV_ENV_FILE before the
# cluster stages. Set to "false" to leave provisioning to a human and skip cluster
# stages on a red check.
# PRAUTO_CLUSTER_PROVISION_ENABLED="true"

# Budget caps (optional — only effective with API billing, ignored on Pro/Max plans)
# PRAUTO_CLAUDE_MAX_BUDGET_ANALYSIS="0.50"
# PRAUTO_CLAUDE_MAX_BUDGET_IMPLEMENTATION="2.00"
# PRAUTO_CLAUDE_MAX_BUDGET_INTEGRATION_FIX="1.00"
# PRAUTO_CLAUDE_MAX_BUDGET_E2E_FIX="1.00"

# Maximum open issues this worker can hold concurrently (default: 1).
# Counts all open issues assigned to this worker with any prauto: label.
# Higher values let the worker pick up new issues while existing ones are pending.
PRAUTO_OPEN_ISSUE_LIMIT=1

# PR reviewer (GitHub login). Set to the human reviewer.
# Leave empty if the repo owner is an org — org names are not valid reviewers.
PRAUTO_REVIEWER=""

# Secrets (optional — leave empty to use system auth / keyring credentials)
ANTHROPIC_API_KEY=""
GH_TOKEN=""
