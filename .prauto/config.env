# Prauto shared configuration — committed to repo.
# Instance-specific overrides go in config.local.env (gitignored).

# GitHub
PRAUTO_GITHUB_REPO="selhorys/dataspoke-baseline"
PRAUTO_GITHUB_LABEL_READY="prauto:ready"
PRAUTO_GITHUB_LABEL_WIP="prauto:wip"
PRAUTO_GITHUB_LABEL_REVIEW="prauto:review"
PRAUTO_GITHUB_LABEL_FAILED="prauto:failed"
PRAUTO_GITHUB_LABEL_DONE="prauto:done"
PRAUTO_GITHUB_LABEL_PLAN_REVIEW="prauto:plan-review"
PRAUTO_BASE_BRANCH="dev"
PRAUTO_BRANCH_PREFIX="prauto/"
# PR reviewer login to request when the PR moves to prauto:review. Leave empty to skip.
# Override in config.local.env if the repo owner is an org (not a GitHub user).
PRAUTO_REVIEWER=""

# Security: restrict prauto:ready issue pickup to organization members only.
# Set to "true" to enable. Requires PRAUTO_GITHUB_REPO to be an org-owned repo.
# When enabled, issues authored by non-members are silently skipped.
PRAUTO_GITHUB_ISSUE_FROM_ORG_MEMBERS_ONLY="true"

# Coding-agent model/effort for prauto's own top-level driver (default — can be overridden in
# config.local.env). This is the single orchestrating agent per wake, not a reviewer role — the
# generator/reviewer split lives in the native subagent bindings (.claude/agents/, .codex/agents/)
# it delegates to per AGENTS.md §Implementation Workflow.
PRAUTO_CLAUDE_MODEL="sonnet"
PRAUTO_CLAUDE_EFFORT="high"
# Leave PRAUTO_CODEX_MODEL and PRAUTO_CODEX_EFFORT unset to inherit the
# account's Codex defaults. An explicit formal model identifier and reasoning
# effort are an atomic pair for account/API environments that support
# `codex exec -m`; validation lives in lib/agent.sh.

# Dev cluster binding (per-worker). PRAUTO_DEV_ENV_FILE selects the dev-profile
# cluster this worker provisions, deploys to, and tests against. A relative value
# resolves under the repo checkout; an absolute value is used as given. The default
# points at the shared human cluster — safe only for single-worker or testing use.
# Point it at a dedicated cluster's env file in config.local.env for real use.
PRAUTO_DEV_ENV_FILE="helm-charts/.env.dev"

# Cluster provisioning. When the dev-env health check is red or the cluster is absent,
# run a full dev-profile install before the cluster stages, then re-check. A
# provisioning failure skips those stages (it never fails the issue) and does not count
# against PRAUTO_MAX_RETRIES_PER_JOB. Set to "false" to disable and skip on a red check.
PRAUTO_CLUSTER_PROVISION_ENABLED="true"

# Wall-clock backstop for one health-check.sh run, in seconds. The script bounds
# its own probes; this covers the case where it cannot report at all.
PRAUTO_HEALTH_CHECK_TIMEOUT_SECS=300

# Wall-clock backstop for one install.sh --profile dev provisioning run, in
# seconds. install.sh has no timeout of its own (e.g. `helm dependency build`
# can wedge indefinitely on a Docker credential-helper prompt); a fired
# backstop group-kills the whole process tree and is handled exactly like any
# other provisioning failure — see spec/AI_PRAUTO.md §Provisioning.
PRAUTO_PROVISION_TIMEOUT_SECS=3600

# Wall-clock backstop for one coding-agent invocation (claude/codex), in seconds.
# A hung or stalled agent is killed after this; classify_exit then treats it as
# an ordinary error (retry on a later wake), never a resume. Default 24h.
PRAUTO_AGENT_TIMEOUT_SECS=86400

# Limits (defaults — can be overridden in config.local.env)
PRAUTO_MAX_RETRIES_PER_JOB=4

# Scheduler — repo-level cadence, reporting, and supervision conventions for the reference
# Hermes cron binding. The reference binding is an AGENT-SUPERVISED Hermes cron job: each tick
# wakes a supervisor agent that (1) reports the trigger to Slack, (2) detaches the executor when
# idle, and (3) spawns the background monitor (.prauto/scheduler/monitor.sh) that keeps posting
# brief Slack notes until the coding agent finishes. The supervisor performs no issue work — the
# executor owns every tick step. Hermes is ONE example, not a requirement; these fields define
# WHAT that reference job is, shared across every clone. Instance identity (the local checkout
# path = the job's workdir, and the delivery target) lives in config.local.env and must not be
# committed.
#
# NOTE: no code in .prauto/ reads any PRAUTO_SCHEDULER_HERMES_* value. They are
# the reference job's definition, recorded here so a fresh clone can recreate the
# same job — an operator transcribes them when creating the cron job. Changing
# one has no effect on a running worker; it changes what the next person
# creating the job will use. (PRAUTO_SCHEDULER_HERMES_HOME in config.local.env
# is the exception: scheduler/monitor.sh does read that one.)
PRAUTO_SCHEDULER_HERMES_SCHEDULE="15 * * * *"   # hourly at :15 past (the supervisor wake cadence)
PRAUTO_SCHEDULER_HERMES_NAME="DataSpoke PRauto heartbeat"
PRAUTO_SCHEDULER_HERMES_SKILL="prauto-executor" # supervisor agent skill (loaded by the cron job)
# Canonical supervisor prompt (the cron job's `prompt` field) and the supervisor skill source —
# both committed to the repo so the job is reproducible on a fresh install. Install the skill into
# the Hermes profile's skills dir before creating the job (see spec/AI_PRAUTO.md §Supervisor prompt
# and skill).
PRAUTO_SCHEDULER_HERMES_PROMPT_FILE=".prauto/scheduler/supervisor-prompt.md"
PRAUTO_SCHEDULER_HERMES_SKILL_FILE=".prauto/scheduler/prauto-executor/SKILL.md"

# Slack reporting — the supervisor and the monitor both post here. Defaults to the worker's
# Slack channel; override in config.local.env for a fork or another machine.
PRAUTO_SLACK_TARGET="slack:hermes-dev"
# Monitor cadence: poll executor liveness every CHECK_SECS, and post a Slack note every
# INTERVAL_SECS while the coding agent is running (a finish is reported immediately).
PRAUTO_MONITOR_CHECK_SECS=60
PRAUTO_MONITOR_INTERVAL_SECS=600
# Delay between the monitor's two Slack send attempts. A transient blip is retried once
# before the message is recorded in .prauto/state/monitor-undelivered.log.
PRAUTO_MONITOR_SEND_RETRY_SECS=5
