# Prauto shared configuration — committed to repo.
# Instance-specific overrides go in config.local.env (gitignored).

# GitHub
PRAUTO_GITHUB_REPO="selhorys/dataspoke-baseline"
PRAUTO_GITHUB_LABEL_READY="prauto:ready"
PRAUTO_GITHUB_LABEL_WIP="prauto:wip"
PRAUTO_GITHUB_LABEL_REVIEW="prauto:review"
PRAUTO_GITHUB_LABEL_FAILED="prauto:failed"
PRAUTO_GITHUB_LABEL_DONE="prauto:done"
PRAUTO_GITHUB_LABEL_PLAN_REVIEW="prauto:plan-review"
PRAUTO_BASE_BRANCH="dev"
PRAUTO_BRANCH_PREFIX="prauto/"
# PR reviewer login to request on gh pr create. Leave empty to skip --reviewer.
# Override in config.local.env if the repo owner is an org (not a GitHub user).
PRAUTO_REVIEWER=""

# Security: restrict prauto:ready issue pickup to organization members only.
# Set to "true" to enable. Requires PRAUTO_GITHUB_REPO to be an org-owned repo.
# When enabled, issues authored by non-members are silently skipped.
PRAUTO_GITHUB_ISSUE_FROM_ORG_MEMBERS_ONLY="true"

# Claude model (default — can be overridden in config.local.env)
PRAUTO_CLAUDE_MODEL="opus"

# Dev cluster binding (per-worker). PRAUTO_DEV_ENV_FILE selects the dev-profile
# cluster this worker provisions, deploys to, and tests against. A relative value
# resolves under the repo checkout; an absolute value is used as given. The default
# points at the shared human cluster — safe only for single-worker or testing use.
# Point it at a dedicated cluster's env file in config.local.env for real use.
PRAUTO_DEV_ENV_FILE="helm-charts/.env.dev"

# Cluster provisioning. When the dev-env health check is red or the cluster is absent,
# run a full dev-profile install before the cluster stages, then re-check. A
# provisioning failure skips those stages (it never fails the issue) and does not count
# against PRAUTO_MAX_RETRIES_PER_JOB. Set to "false" to disable and skip on a red check.
PRAUTO_CLUSTER_PROVISION_ENABLED="true"

# Wall-clock backstop for one health-check.sh run, in seconds. The script bounds
# its own probes; this covers the case where it cannot report at all.
PRAUTO_HEALTH_CHECK_TIMEOUT_SECS=300

# Wall-clock backstop for one coding-agent invocation (claude/codex), in seconds.
# A hung or stalled agent is killed after this; classify_exit then treats it as
# an ordinary error (retry on a later wake), never a resume. Default 24h.
PRAUTO_AGENT_TIMEOUT_SECS=86400

# Limits (defaults — can be overridden in config.local.env)
PRAUTO_MAX_RETRIES_PER_JOB=3

# Loop master (Hermes cron binding) — repo-level conventions.
# The loop master is a scheduled Hermes cron job. These define WHAT the job is,
# shared across every clone. Instance identity (Hermes profile, checkout path,
# delivery target) lives in config.local.env and must not be committed.
PRAUTO_LOOP_MASTER_HERMES_SCHEDULE="every 4h"
PRAUTO_LOOP_MASTER_HERMES_NAME="DataSpoke PRauto loop master"
PRAUTO_LOOP_MASTER_HERMES_SKILLS="prauto-loop-master claude-code codex"
PRAUTO_LOOP_MASTER_HERMES_TOOLSETS="terminal file"
