.env.*
*.local
**/.next/
.git/
.venv/
ref/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.claude/
helm-charts/
spec/
tests/
docs/
.prauto/
*.egg-info/
