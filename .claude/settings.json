{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./helm-charts/bin/install.sh*)",
      "Bash(./helm-charts/bin/uninstall.sh*)",
      "Bash(./helm-charts/bin/health-check.sh*)",
      "Bash(./helm-charts/bin/build-image.sh*)",
      "Bash(date *)",
      "Bash(docker images*)",
      "Bash(docker inspect *)",
      "Bash(docker ps*)",
      "Bash(git branch*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(grep:*)",
      "Bash(helm list *)",
      "Bash(helm repo *)",
      "Bash(helm show *)",
      "Bash(helm status *)",
      "Bash(kubectl cluster-info*)",
      "Bash(kubectl config current-context*)",
      "Bash(kubectl config get-contexts*)",
      "Bash(kubectl config use-context *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl version *)",
      "Bash(minikube *)",
      "Bash(pnpm:*)",
      "Bash(sleep *)",
      "Bash(env -u CLAUDECODE bash*)",
      "Bash(tail */tmp/*)",
      "Skill(datahub-api)",
      "Skill(k8s-deploy)",
      "Skill(k8s-work)",
      "Skill(spec-write)",
      "Skill(prauto-check-status)",
      "Skill(spec-harmonize)",
      "Skill(spec-reduce)",
      "Skill(spec-sync-with-impl)",
      "WebSearch",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:docs.pydantic.dev)",
      "WebFetch(domain:docs.sqlalchemy.org)",
      "WebFetch(domain:alembic.sqlalchemy.org)",
      "WebFetch(domain:airflow.apache.org)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:radix-ui.com)",
      "WebFetch(domain:recharts.org)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:helm.sh)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:datahubproject.io)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "deny": [
      "Bash(kubectl delete namespace *)",
      "Bash(kubectl delete ns *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(uv run pytest tests/integration*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/preflight-integration-tests.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/confirm-commit.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/plan-gate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/permission-hygiene-check.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/statusline.sh"
  }
}
