# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Env files anywhere in the repo — deny by default. Unanchored (no leading
# /) so it covers not just the repo root and helm-charts/ but any path a
# --env-file argument to bin/install.sh or bin/uninstall.sh can name (e.g.
# deploy/.env.staging). Matches on basename, so .prauto/config.env,
# .prauto/config.local.env.example, and migrations/env.py are unaffected
# (their basenames don't start with ".env"). *.example templates and
# .envrc (direnv config, not a credential file) are re-included.
.env*
!.env*.example
!.envrc
helm-charts/dataspoke/charts/
helm-charts/dev-peripherals/langfuse/charts/
memory/
!scaffold/memory/
.claude/*.local.*
.claude/plans/
.claude/worktrees/
.claude/todos/
.claude/scheduled_tasks.lock
.prauto/*.local.*
.prauto/state/
.prauto/worktrees/
issues/
